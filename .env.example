# Скопіюй у .env і змін паролі
POSTGRES_USER=technokit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=technokit

# Для локальної розробки (бекенд запущений на ноуті, БД у Docker)
DATABASE_URL=postgres://technokit:change_me@localhost:5432/technokit

PORT=3000
NODE_ENV=development
# true лише коли сайт працює по HTTPS
COOKIE_SECURE=false
